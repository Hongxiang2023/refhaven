{
  "name": "refhaven-reference-manager",
  "version": "0.1.8",
  "description": "A free, local-first reference manager for reading papers and writing manuscripts",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/prepare-pdfjs.mjs && tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "dev": "node scripts/prepare-pdfjs.mjs && vite --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "desktop": "npm run build && electron .",
    "dist:desktop": "npm run build && electron-builder --publish never",
    "package:connector": "node scripts/package-connector.mjs",
    "check": "npm run build && npm test",
    "package:plugin": "node scripts/package-codex-plugin.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "citeproc": "2.4.63",
    "jszip": "3.10.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "org.folio.reference-manager",
    "productName": "Refhaven",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "server/**",
      "desktop/**",
      "extension/**",
      "package.json",
      "LICENSE",
      "CSL-NOTICES.md",
      "assets/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "extendInfo": {
        "CFBundleDisplayName": "Refhaven"
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "extraResources": [
      {
        "from": "extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/electron/LICENSE",
        "to": "licenses/Electron-LICENSE.txt"
      },
      {
        "from": "assets/licenses/LICENSES.chromium.html",
        "to": "licenses/LICENSES.chromium.html"
      }
    ]
  }
}
